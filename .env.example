# White Rabbit API Environment
# Copy this file to .env and fill in your actual API keys for local development.
# Never commit .env to git.

# Required for Scout search
TAVILY_API_KEY=tvly-your-tavily-key-here

# Required for lead extraction
OPENAI_API_KEY=sk-your-openai-key-here

# Shared password for the web app (used by apps/web)
WR_SHARED_PASSWORD=your-shared-password-here

# Session secret for auth cookies (used by apps/web)
WR_SESSION_SECRET=your-session-secret-here-min-32-chars
