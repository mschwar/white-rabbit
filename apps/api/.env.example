# White Rabbit API Environment
# Copy this file to .env and fill in your actual API keys for local development.
# Never commit .env to git.

# Required for Scout search
TAVILY_API_KEY=tvly-your-tavily-key-here

# Required for lead extraction
OPENAI_API_KEY=sk-you...here

# Optional. Override only for dev with a local OpenAI-compatible endpoint
# (e.g. http://localhost:11434/v1 for Ollama). Leave empty for production.
# OPENAI_BASE_URL=

# Postgres connection string. Required in production; optional in dev (falls back to localhost).
# DATABASE_URL=postgresql://user:pass@localhost:5432/white_rabbit

# Environment flag. Set to "production" to enforce strict env checks.
# WR_ENV=development

# Shared password for the web app (used by apps/web)
WR_SHARED_PASSWORD=your-shared-password-here

# Session secret for auth cookies (used by apps/web)
WR_SESSION_SECRET=your-session-secret-here-min-32-chars

# Shared token that the Next.js proxy forwards to the FastAPI boundary
WR_API_INTERNAL_TOKEN=your-internal-api-token-here
