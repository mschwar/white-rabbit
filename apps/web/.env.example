# White Rabbit Web Environment
# Copy this file to .env.local and keep the same internal API token as the API.

WR_API_BASE_URL=http://localhost:8000
WR_SHARED_PASSWORD=your-shared-password-here
WR_SESSION_SECRET=your-session-secret-here-min-32-chars
WR_API_INTERNAL_TOKEN=your-internal-api-token-here
